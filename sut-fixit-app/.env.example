# ==========================================
# Firebase config สำหรับ SUT FixIt (ฝั่งแอป / client)
# ==========================================
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงให้ครบทุกตัว
#   cp .env.example .env.local
# หลังแก้ไฟล์ .env ทุกครั้ง ต้องรีสตาร์ทพร้อมล้าง cache: npx expo start -c
#
# หมายเหตุ: prefix EXPO_PUBLIC_ ทำให้ค่าถูกฝังลงใน bundle ของแอป
# ค่าเหล่านี้จึงไม่ใช่ความลับ (Firebase web config เปิดเผยได้ตามปกติ)
# ห้ามใส่ service account key หรือ private key ไว้ในไฟล์นี้เด็ดขาด

EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
